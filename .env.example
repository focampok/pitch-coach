# Clave de la API de Gemini. Se usa únicamente en API routes (server-side),
# nunca expuesta al cliente (no usar prefijo NEXT_PUBLIC_).
# Gemini AI
GEMINI_API_KEY="AQ.Ab8RN6JCTBAyq3Yee7QeDmoXyusk2NziUH56WPmuWd5qkoZ28g"
# Modelo principal. Verificado con generateContent (HTTP 200):
# gemini-3.1-flash-lite, gemini-3.5-flash, gemini-3.6-flash funcionan.
# OJO: gemini-2.5-flash aparece en la lista de modelos pero su generateContent
# responde 404 para esta key — NO usarlo.
GEMINI_MODEL="gemini-3.1-flash-lite"
# Fallbacks verificados con generateContent (HTTP 200)
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-3.6-flash"
GEMINI_RETRY_ATTEMPTS="3"
GEMINI_RETRY_DELAY_MS="1000"
GEMINI_RETRY_MAX_DELAY_MS="8000"


# Clave de ElevenLabs: TTS del veredicto y, opcionalmente, Scribe (STT).
# Solo server-side. Sin ella, el veredicto usa el fallback SpeechSynthesis.
ELEVENLABS_API_KEY=

# Clave de Tavily: búsqueda de estadísticas reales para sugerencias del
# dashboard. Solo server-side. Sin ella, el dashboard omite las sugerencias.
TAVILY_API_KEY=
