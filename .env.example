# =============================================================================
# Pitch Coach — environment variables
# Copy this file to .env.local and fill in the values (server-side only).
# =============================================================================

# --- Analysis model provider ---
# "nebius" (default) or "gemini".
#   nebius → default deploy provider. Requires NEBIUS_API_KEY.
#   gemini → MANUAL FALLBACK (see the section at the end).
MODEL_PROVIDER=nebius

# --- Nebius Token Factory (only if MODEL_PROVIDER=nebius) ---
# REQUIRED with MODEL_PROVIDER=nebius: if it is missing, analysis fails in the
# open with an explicit error. Server-side only (never a NEXT_PUBLIC_ prefix).
NEBIUS_API_KEY=
# Base URL of the OpenAI-compatible endpoint. Default:
# https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=
# Model for "Ultra analysis" (thinking left on).
# Default: nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_ULTRA=
# Model for the "fast" tier (Nano; sparring, room, figures, timeline, retake).
# Thinking off. Default: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_NANO=

# --- Model settings (neutral names, not tied to one provider) ---
# Read by the neutral layer (src/lib/modelo.ts) and the adapters
# (src/lib/proveedor-nebius.ts, src/lib/proveedor-gemini.ts).
# Primary model. For Nebius the default is nvidia/nemotron-3-super-120b-a12b.
# For Gemini, an empty value falls through to GEMINI_MODEL and then gemini-2.0-flash.
MODEL=
# Comma-separated fallbacks. On Nebius they are used as written (no GEMINI_* alias).
# On Gemini, an empty value falls through to GEMINI_FALLBACK_MODELS.
MODEL_FALLBACK_MODELS=
# Output token cap per call. Default: 1024
MODEL_MAX_TOKENS=
# Sampling temperature (0-2). Default: 0.7
MODEL_TEMPERATURE=
# Retries per model on transient errors (408/429/5xx/timeout). Default: 3
MODEL_RETRY_ATTEMPTS=
# Base delay (ms) for exponential backoff. Default: 1000
MODEL_RETRY_DELAY_MS=
# Backoff cap (ms). Default: 8000
MODEL_RETRY_MAX_DELAY_MS=

# =============================================================================
# FALLBACK — Gemini (only applies if MODEL_PROVIDER=gemini)
# =============================================================================
# MODEL_PROVIDER=gemini is a MANUAL FALLBACK. It is not used in the default
# deploy (that deploy runs on Nebius).
#
# The notes below are GEMINI-SPECIFIC and do NOT apply to Nebius:
#   - Checked with generateContent (HTTP 200): gemini-3.1-flash-lite,
#     gemini-3.5-flash, and gemini-3.6-flash work.
#   - gemini-2.5-flash appears in the model list but generateContent returns
#     404 for this key — do NOT use it.
#   - The GEMINI_* aliases below only take effect on Gemini: they are accepted
#     when the matching MODEL_* value is empty, so switching providers does not
#     force a rename of variables already set in a deploy.
#
# Gemini key. REQUIRED only when MODEL_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_RETRY_ATTEMPTS=
GEMINI_RETRY_DELAY_MS=
GEMINI_RETRY_MAX_DELAY_MS=


# ElevenLabs key: verdict TTS and STT (Scribe).
# Server-side only. Without it, the verdict uses SpeechSynthesis and STT
# fails (the client offers backup text).
ELEVENLABS_API_KEY=
# ElevenLabs voice ids (VoiceLab → voice → Voice ID). Server-side only.
# If they are missing, /api/tts fails and the client falls back to SpeechSynthesis.
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=
# Same pair, for an English session. Without them, English /api/tts fails
# and the client falls back to SpeechSynthesis. The session gender does not change.
ELEVENLABS_VOICE_ID_EN_MALE=
ELEVENLABS_VOICE_ID_EN_FEMALE=
# Scribe model (batch). Default: scribe_v2. Server-side only.
# Leave it unless ElevenLabs publishes another batch model.
ELEVENLABS_SCRIBE_MODEL=

# Tavily key: real statistics for dashboard suggestions, the room objection,
# and the check on a figure the speaker already said.
# Server-side only. Without it, the dashboard omits those sections.
TAVILY_API_KEY=

# =============================================================================
# Sentry — error monitoring and tracing
# =============================================================================
# Without these variables the app still runs: the SDK simply sends nothing
# (it does not break the build or the runtime). Optional for the critical loop.

# DSN for the server and edge runtime (Node.js + Edge). Server-side only.
# Shape: https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_DSN=

# Browser runtime DSN.
#
# DELIBERATE EXCEPTION TO THE NEXT_PUBLIC_ RULE (see CLAUDE.md):
# the client bundle needs the DSN at build time, so it uses the prefix. A
# Sentry DSN is a PUBLIC ingest key by design (it is meant to live in the
# browser), not a secret. The rule "never NEXT_PUBLIC_ for credentials" still
# applies to everything else: SENTRY_AUTH_TOKEN below is the secret and never
# uses the prefix.
NEXT_PUBLIC_SENTRY_DSN=

# --- Environment and master switch ---
# Environment reported to Sentry. Default: "production".
#
# If left empty it falls through to NODE_ENV ("development" locally,
# "production" on the Railway build) and only then to "production". That
# fallback keeps local development from being labeled "production" and mixed
# with real events in the same Sentry view.
SENTRY_ENVIRONMENT=

# Master switch. Any value other than the string "false" leaves it on, so an
# empty variable defaults to on. Use it to turn Sentry off locally without
# deleting code or commenting out Sentry.init.
SENTRY_ENABLED=

# Browser equivalents. Next.js only inlines static NEXT_PUBLIC_* references
# into the client bundle, so the client cannot read the two variables above
# and needs its own. Empty = NODE_ENV and on.
#
# ON RAILWAY: Next.js does that replacement at BUILD TIME, and only if the
# value is present then. A Dockerfile build does not see service variables
# unless they are declared with ARG (see Dockerfile), so these three must
# exist as service variables BEFORE the deploy. If they are missing, the
# browser SDK starts without a DSN and the client reports nothing, with no
# visible error.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENABLED=

# Hosts that receive trace headers (sentry-trace/baggage). They are NOT set
# by environment variable: they live in src/lib/sentry-options.ts
# (TRACE_PROPAGATION_TARGETS) so they can be tested.

# --- Build time only (source map upload) ---
# Auth token used to upload source maps during `next build`. A different
# secret from the DSN: without it the build does not upload maps and
# production stack traces stay minified.
#
# Locally: do NOT put it here — it goes in .env.sentry-build-plugin (gitignored;
# the plugin reads it automatically).
# On Railway: set it in the project Settings → Variables.
SENTRY_AUTH_TOKEN=

# Sentry organization and project, used by withSentryConfig for the source
# map upload. Build time only.
SENTRY_ORG=
SENTRY_PROJECT=

# Sentry release. Passed explicitly ONLY on the Railway build (where
# .dockerignore excludes .git and automatic detection from the git SHA finds
# nothing). On Railway: SENTRY_RELEASE=${{RAILWAY_GIT_COMMIT_SHA}}.
#
# Do NOT uncomment this locally: in development the SDK detects the release
# from git, and an empty variable here would overwrite it with "" — local
# events would be tagged with an empty release instead of the SHA.
# SENTRY_RELEASE=
