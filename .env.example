# =============================================================================
# Pitch Coach — variables de entorno
# Copia este archivo a .env.local y completa los valores (solo server-side).
# =============================================================================

# --- Proveedor del modelo de análisis ---
# "nebius" (por defecto) o "gemini".
#   nebius → proveedor del despliegue por defecto. Requiere NEBIUS_API_KEY.
#   gemini → RESPALDO MANUAL DE CONTINGENCIA (ver sección al final).
MODEL_PROVIDER=nebius

# --- Nebius Token Factory (solo si MODEL_PROVIDER=nebius) ---
# REQUERIDA con MODEL_PROVIDER=nebius: si falta, el análisis falla en claro con
# un error explícito. Solo server-side (nunca prefijo NEXT_PUBLIC_).
NEBIUS_API_KEY=
# Base URL del endpoint OpenAI-compatible. Default:
# https://api.tokenfactory.nebius.com/v1
NEBIUS_BASE_URL=
# Modelo del modo "Análisis Ultra" (razonamiento activo).
# Default: nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_ULTRA=
# Modelo del modo "rápido" (Nano; p. ej. sparring). Sin razonamiento.
# Default: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_NANO=

# --- Configuración del modelo (nombres neutros, no atados a un proveedor) ---
# Los lee la capa neutra (src/lib/modelo.ts) y los adaptadores
# (src/lib/proveedor-nebius.ts, src/lib/proveedor-gemini.ts).
# Modelo principal. Para Nebius el default es nvidia/nemotron-3-super-120b-a12b.
# Para Gemini, si está vacío se usa GEMINI_MODEL y luego gemini-2.0-flash.
MODEL=
# Fallbacks separados por comas. En Nebius se usan tal cual (sin alias GEMINI_*).
# En Gemini, si está vacío se usa GEMINI_FALLBACK_MODELS.
MODEL_FALLBACK_MODELS=
# Tope de tokens de salida por llamada. Default: 1024
MODEL_MAX_TOKENS=
# Temperatura de muestreo (0-2). Default: 0.7
MODEL_TEMPERATURE=
# Reintentos por modelo ante errores transitorios (408/429/5xx/timeout). Default: 3
MODEL_RETRY_ATTEMPTS=
# Delay base (ms) del backoff exponencial. Default: 1000
MODEL_RETRY_DELAY_MS=
# Tope del backoff (ms). Default: 8000
MODEL_RETRY_MAX_DELAY_MS=

# =============================================================================
# CONTINGENCIA — Gemini (solo aplica si MODEL_PROVIDER=gemini)
# =============================================================================
# MODEL_PROVIDER=gemini es un RESPALDO MANUAL DE CONTINGENCIA, no se usa en el
# despliegue por defecto (que corre con Nebius).
#
# Las notas de abajo son ESPECÍFICAS DE GEMINI y NO aplican a Nebius:
#   - Verificado con generateContent (HTTP 200): gemini-3.1-flash-lite,
#     gemini-3.5-flash, gemini-3.6-flash funcionan.
#   - OJO: gemini-2.5-flash aparece en la lista de modelos pero su
#     generateContent responde 404 para esta key — NO usarlo.
#   - Los alias GEMINI_* de abajo solo tienen efecto en Gemini: se aceptan
#     cuando el MODEL_* equivalente está vacío, así migrar de proveedor no
#     obliga a renombrar variables ya desplegadas.
#
# Clave de Gemini. REQUERIDA solo cuando MODEL_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_RETRY_ATTEMPTS=
GEMINI_RETRY_DELAY_MS=
GEMINI_RETRY_MAX_DELAY_MS=


# Clave de ElevenLabs: TTS del veredicto y, opcionalmente, Scribe (STT).
# Solo server-side. Sin ella, el veredicto usa el fallback SpeechSynthesis.
ELEVENLABS_API_KEY=
# Voice IDs de ElevenLabs (VoiceLab → voz → Voice ID). Solo server-side.
# Si faltan, /api/tts falla y el cliente cae a SpeechSynthesis.
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_VOICE_ID_FEMALE=

# Clave de Tavily: búsqueda de estadísticas reales para sugerencias del
# dashboard. Solo server-side. Sin ella, el dashboard omite las sugerencias.
TAVILY_API_KEY=

# =============================================================================
# Sentry — monitoreo de errores y tracing
# =============================================================================
# Sin estas variables la app funciona igual: el SDK simplemente no envía nada
# (no rompe el build ni el runtime). Son opcionales para el loop crítico.

# DSN del runtime de servidor y edge (Node.js + Edge). Solo server-side.
# Formato: https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_DSN=

# DSN del runtime de navegador.
#
# EXCEPCIÓN CONSCIENTE A LA REGLA DE NEXT_PUBLIC_ (ver CLAUDE.md):
# el bundle del cliente necesita el DSN en build-time, por eso lleva el
# prefijo. Un DSN de Sentry es una clave de ingesta PUBLICA por diseño (está
# pensada para vivir en el navegador), no un secreto. La regla de "nunca
# NEXT_PUBLIC_ para credenciales" sigue aplicando a todo lo demás: el
# SENTRY_AUTH_TOKEN de abajo es el que sí es secreto y nunca lleva el prefijo.
NEXT_PUBLIC_SENTRY_DSN=

# --- Entorno e interruptor maestro ---
# Entorno que se reporta a Sentry. Default: "production".
#
# Si se deja vacío cae a NODE_ENV ("development" en local, "production" en el
# build de Railway) y recién después a "production". Ese fallback evita que el
# desarrollo local se etiquete como "production" y se mezcle con los eventos
# reales en la misma vista de Sentry.
SENTRY_ENVIRONMENT=

# Interruptor maestro. Cualquier valor distinto de la cadena "false" lo deja
# encendido, así que con la variable vacía el default es encendido. Sirve para
# apagar Sentry en local sin borrar código ni comentar los Sentry.init.
SENTRY_ENABLED=

# Equivalentes para el NAVEGADOR. Next.js solo reemplaza en el bundle del
# cliente las referencias estáticas a NEXT_PUBLIC_*, así que el cliente no puede
# leer las dos variables de arriba y necesita las suyas. Vacías = NODE_ENV y
# encendido.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENABLED=

# Hosts a los que se propaga la traza (cabeceras sentry-trace/baggage). NO se
# configuran por variable de entorno: viven en src/lib/sentry-options.ts
# (TRACE_PROPAGATION_TARGETS) para que sean testeables.

# --- Solo build-time (subida de source maps) ---
# Token de autenticación para subir source maps en `next build`. Es un secreto
# distinto del DSN: sin él el build no sube los mapas y los stack traces de
# producción aparecen minificados.
#
# En local: NO se pone acá — va en .env.sentry-build-plugin (gitignoreado,
# lo lee el plugin automáticamente).
# En Railway: se configura en Settings → Variables del proyecto.
SENTRY_AUTH_TOKEN=

# Organización y proyecto de Sentry, usados por withSentryConfig para la
# subida de source maps. Solo build-time.
SENTRY_ORG=
SENTRY_PROJECT=

# Release de Sentry. Se pasa explícito SOLO en el build de Railway (donde
# .dockerignore excluye .git y la detección automática por SHA de git no
# encuentra nada). En Railway: SENTRY_RELEASE=${{RAILWAY_GIT_COMMIT_SHA}}.
#
# NO se descomenta en local: en desarrollo el SDK detecta el release solo a
# partir de git, y una variable vacía acá lo sobreescribiría con "" — los
# eventos locales quedarían etiquetados con un release vacío en vez del SHA.
# SENTRY_RELEASE=
