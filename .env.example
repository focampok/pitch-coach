# Clave de la API de Gemini. Se usa únicamente en API routes (server-side),
# nunca expuesta al cliente (no usar prefijo NEXT_PUBLIC_).
GEMINI_API_KEY=

# Clave de ElevenLabs: TTS del veredicto y, opcionalmente, Scribe (STT).
# Solo server-side. Sin ella, el veredicto usa el fallback SpeechSynthesis.
ELEVENLABS_API_KEY=

# Clave de Tavily: búsqueda de estadísticas reales para sugerencias del
# dashboard. Solo server-side. Sin ella, el dashboard omite las sugerencias.
TAVILY_API_KEY=

# Public key de Vapi para el Web SDK (ronda del inversionista). Es pública
# por diseño de Vapi — única variable permitida con prefijo NEXT_PUBLIC_
# (ver CLAUDE.md). La private key de Vapi, si se usara, va sin prefijo.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
