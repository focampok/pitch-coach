# dependencias
node_modules/

# build de Next.js
.next/
out/

# caché incremental de TypeScript (artefacto de build)
*.tsbuildinfo

# variables de entorno (nunca se comitean)
.env
.env.local
.env*.local
# token de subida de source maps de Sentry (build-time, lo lee el plugin)
.env.sentry-build-plugin

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# sistema operativo / editor
.DS_Store
*.pem

# configuración local de herramientas de agentes (no se comitea)
.claude/settings.local.json
.impeccable/

# grabaciones locales de prueba (ffmpeg / curl a Scribe). Contienen voz;
# no son assets del producto.
/clip.*
/grabacion.*

# Railway (si genera archivos locales de config)
.railway/
next-env.d.ts
